│   ├── company_metadata.csv       # Sector, market cap, headcount, etc.
│   ├── tableau_stock_prices.csv   # Enriched prices file for Tableau
│   ├── tableau_annual_returns.csv # Annual return summary for Tableau
│   ├── tableau_financials.csv     # Financials ready for Tableau
│   └── model_predictions.csv     # Ridge regression predictions (2024)
│
├── python/
│   ├── generate_data.py           # Step 1: create synthetic dataset
│   ├── eda_analysis.py            # Step 2: charts & feature engineering
│   └── return_model.py            # Step 3: return prediction model
│
├── sql/
│   └── schema_and_queries.sql     # MySQL schema + 10 analytical queries
│
├── tableau/
│   └── dashboard_guide.md         # Step-by-step Tableau build instructions
│
└── docs/
    └── plots/                     # 10 auto-generated charts
```

